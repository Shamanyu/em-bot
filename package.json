{
  "name": "em-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/features/weekly-review/src/index.js",
    "dev": "tsx features/weekly-review/src/index.ts",
    "lint": "eslint 'shared/**/*.ts' 'features/**/*.ts'",
    "format": "prettier --write 'shared/**/*.ts' 'features/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@supabase/supabase-js": "^2.105.4",
    "axios": "^1.7.0",
    "dotenv": "^16.4.0",
    "pino": "^9.0.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.0.0"
  }
}
